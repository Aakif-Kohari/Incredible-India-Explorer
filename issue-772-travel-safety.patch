diff --git a/js-modules/safety-data.js b/js-modules/safety-data.js
new file mode 100644
index 0000000..1a4985c
--- /dev/null
+++ b/js-modules/safety-data.js
@@ -0,0 +1,155 @@
+/**
+ * js-modules/safety-data.js
+ * Static reference data for the Intelligent Travel Risk Assessment &
+ * Safety Advisory System (issue #772). Rule-based, client-side only — no
+ * backend — matching how trip-data.js/weather-core.js already work.
+ *
+ * This file intentionally does NOT invent per-city hospital/police names
+ * or per-state helpline numbers, since those go stale and a safety
+ * feature giving wrong specifics is worse than one that fetches live
+ * data. Instead:
+ *  - NATIONAL_EMERGENCY_CONTACTS holds India's nationwide helpline
+ *    numbers (verified against incredibleindia.gov.in/en/emergency and
+ *    india.gov.in/directory/helpline).
+ *  - Nearby hospitals/police stations are fetched live from OpenStreetMap
+ *    (see travel-safety-service.js) rather than hardcoded here.
+ *  - Hazard tags below are well-documented, general geographic/seasonal
+ *    facts (India's BIS seismic zoning, coastal cyclone seasons, Himalayan
+ *    monsoon landslide risk, high-altitude acclimatization) used only to
+ *    decide which generic advisory to surface for a destination — they
+ *    are not claims about current conditions.
+ *
+ * Keyed by the same destination ids as trip-data.js so this can be joined
+ * against root.tripDestinations by id.
+ */
+(function (root) {
+    "use strict";
+
+    // ------------------------------------------------------------------
+    // Nationwide emergency numbers (India). Dial 112 for any emergency —
+    // it routes to police/fire/ambulance under the Emergency Response
+    // Support System (ERSS). The rest are specialised lines.
+    // ------------------------------------------------------------------
+    const NATIONAL_EMERGENCY_CONTACTS = [
+        { id: "national", label: "National Emergency Number (Police/Fire/Ambulance)", number: "112", note: "Single number, works nationwide, 24/7. Save this first." },
+        { id: "police", label: "Police", number: "100", note: "Also reachable via 112." },
+        { id: "fire", label: "Fire", number: "101" },
+        { id: "ambulance", label: "Ambulance", number: "102" },
+        { id: "disaster", label: "Disaster Management Helpline", number: "108" },
+        { id: "tourist", label: "24x7 Tourist Helpline", number: "1363", altNumber: "1800-11-1363", note: "Multilingual (English, Hindi, and 10+ other languages). For travel info and distress situations." },
+        { id: "women", label: "Women Helpline", number: "1091" },
+        { id: "child", label: "Child Helpline", number: "1098" },
+        { id: "railway", label: "Railway Enquiry / Security", number: "139" },
+        { id: "roadAccident", label: "Road Accident Emergency", number: "1073" },
+        { id: "cyberCrime", label: "Cyber Crime Helpline", number: "1930" },
+        { id: "seniorCitizen", label: "Senior Citizen Helpline", number: "14567" }
+    ];
+
+    // ------------------------------------------------------------------
+    // Hazard tags — small curated sets, not a claim about live conditions.
+    // ------------------------------------------------------------------
+
+    // High-altitude destinations (~3,000m+) where acute mountain sickness
+    // is a genuine, well-documented risk for travelers arriving quickly
+    // from low altitude (e.g. by flight).
+    const HIGH_ALTITUDE_IDS = ["leh", "spiti"];
+
+    // Coastal / island destinations that fall in the Bay of Bengal or
+    // Arabian Sea cyclone belt, where the pre-monsoon (Apr-Jun) and
+    // post-monsoon (Oct-Dec) windows see the most cyclone activity.
+    const CYCLONE_BELT_IDS = [
+        "andaman", "goa", "gokarna", "varkala", "alleppey", "kochi",
+        "pondicherry", "chennai", "mahabalipuram", "sundarbans",
+        "lakshadweep", "diu"
+    ];
+    const CYCLONE_MONTHS = [4, 5, 6, 10, 11, 12]; // 1-indexed calendar months
+
+    // Himalayan / hill-road destinations prone to monsoon landslides and
+    // road closures (Jun-Sep).
+    const LANDSLIDE_PRONE_IDS = [
+        "shimla", "manali", "leh", "darjeeling", "gangtok",
+        "mcleodganj", "spiti", "munnar", "ooty", "coorg", "rishikesh", "haridwar"
+    ];
+    const MONSOON_MONTHS = [6, 7, 8, 9];
+
+    // Destinations in India's higher seismic-activity zones (BIS IS
+    // 1893 Zone IV/V — the Himalayan belt, the northeast, and Kutch).
+    const HIGH_SEISMIC_ZONE_IDS = [
+        "leh", "spiti", "shimla", "manali", "darjeeling", "gangtok",
+        "mcleodganj", "amritsar", "rishikesh", "haridwar",
+        "rann-of-kutch", "kaziranga"
+    ];
+
+    // Desert destinations with extreme pre-monsoon heat (Apr-Jun).
+    const EXTREME_HEAT_IDS = ["jaisalmer", "jodhpur", "rann-of-kutch"];
+    const EXTREME_HEAT_MONTHS = [4, 5, 6];
+
+    // Destinations centered on wildlife viewing, where the main safety
+    // consideration is following ranger/guide rules rather than crime.
+    const WILDLIFE_ENCOUNTER_IDS = [
+        "ranthambore", "kaziranga", "jim-corbett", "periyar", "sundarbans"
+    ];
+
+    // Baseline safety score (0-100, higher = safer) used as a starting
+    // point before weather/seismic/seasonal adjustments. City destinations
+    // with dense tourist infrastructure start a little higher than remote
+    // or wilderness ones; this is a coarse heuristic, not a ranking of
+    // any place as "unsafe" in absolute terms — India's tourist areas are,
+    // in general, well-patrolled and used by millions of visitors yearly.
+    const BASE_SCORE_BY_CATEGORY = {
+        city: 88,
+        heritage: 85,
+        historical: 85,
+        spiritual: 83,
+        beaches: 80,
+        backwaters: 80,
+        desert: 78,
+        mountains: 76,
+        adventure: 72,
+        wildlife: 74
+    };
+
+    function baseScoreForDestination(destination) {
+        if (!destination || !destination.categories || !destination.categories.length) return 80;
+        const scores = destination.categories.map((c) => BASE_SCORE_BY_CATEGORY[c] || 80);
+        return Math.round(scores.reduce((a, b) => a + b, 0) / scores.length);
+    }
+
+    // ------------------------------------------------------------------
+    // Generic, non-destination-specific checklist items shown for every
+    // trip, before personalization in travel-safety-core.js adds more.
+    // ------------------------------------------------------------------
+    const BASE_SAFETY_CHECKLIST = [
+        { id: "insurance", label: "Buy travel insurance covering medical evacuation", category: "before" },
+        { id: "id-copies", label: "Carry photo + digital copies of ID and travel documents", category: "before" },
+        { id: "share-itinerary", label: "Share your itinerary and hotel details with someone at home", category: "before" },
+        { id: "emergency-numbers", label: "Save national + local emergency numbers in your phone", category: "before" },
+        { id: "medications", label: "Pack a basic first-aid kit and any personal medication", category: "before" },
+        { id: "water", label: "Drink bottled/filtered water; avoid tap water", category: "during" },
+        { id: "night-transport", label: "Prefer pre-booked or app-based transport after dark", category: "during" },
+        { id: "valuables", label: "Keep valuables split between bags, not all in one place", category: "during" }
+    ];
+
+    const api = {
+        NATIONAL_EMERGENCY_CONTACTS,
+        HIGH_ALTITUDE_IDS,
+        CYCLONE_BELT_IDS,
+        CYCLONE_MONTHS,
+        LANDSLIDE_PRONE_IDS,
+        MONSOON_MONTHS,
+        HIGH_SEISMIC_ZONE_IDS,
+        EXTREME_HEAT_IDS,
+        EXTREME_HEAT_MONTHS,
+        WILDLIFE_ENCOUNTER_IDS,
+        BASE_SCORE_BY_CATEGORY,
+        baseScoreForDestination,
+        BASE_SAFETY_CHECKLIST
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.SafetyData = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
diff --git a/js-modules/travel-safety-core.js b/js-modules/travel-safety-core.js
new file mode 100644
index 0000000..d5cb1e5
--- /dev/null
+++ b/js-modules/travel-safety-core.js
@@ -0,0 +1,333 @@
+/**
+ * js-modules/travel-safety-core.js
+ * Intelligent Travel Risk Assessment & Safety Advisory System (issue #772)
+ * — rule-based logic module.
+ *
+ * Pure functions only: no DOM, no fetch, no localStorage. Live inputs
+ * (weather, earthquakes, nearby hospitals/police) are fetched by
+ * travel-safety-service.js and passed in already-resolved, the same
+ * split used by weather-core.js / weather-service.js / weather-ui.js.
+ * Kept separate so scoring/advisory/checklist rules can be unit tested
+ * without a browser (see tests/unit/travel-safety-core.test.js).
+ *
+ * Depends on window.SafetyData (safety-data.js) for hazard tables and,
+ * optionally, window.WeatherCore (weather-core.js) for weather severity
+ * classification — both are passed through function args here rather
+ * than referenced globally, so this module can be required standalone
+ * in tests.
+ *
+ * Exposed as window.TravelSafetyCore (browser) and module.exports (Node/Vitest).
+ */
+(function (root) {
+    "use strict";
+
+    // ------------------------------------------------------------------
+    // Risk levels
+    // ------------------------------------------------------------------
+    const RISK_LEVELS = [
+        { max: 100, min: 80, level: "low", label: "Low risk", color: "#2e7d32" },
+        { max: 79, min: 60, level: "moderate", label: "Moderate risk", color: "#f9a825" },
+        { max: 59, min: 35, level: "elevated", label: "Elevated risk", color: "#ef6c00" },
+        { max: 34, min: 0, level: "high", label: "High risk", color: "#c62828" }
+    ];
+
+    function classifyScore(score) {
+        const clamped = Math.max(0, Math.min(100, score));
+        const bucket = RISK_LEVELS.find((r) => clamped >= r.min && clamped <= r.max) || RISK_LEVELS[RISK_LEVELS.length - 1];
+        return { score: Math.round(clamped), level: bucket.level, label: bucket.label, color: bucket.color };
+    }
+
+    // ------------------------------------------------------------------
+    // Seasonal / hazard risk factors derived from safety-data.js tables.
+    // Each returns null (no factor) or { type, severity, delta, message }.
+    // severity: 'info' | 'caution' | 'warning'
+    // delta: score adjustment (negative = riskier)
+    // ------------------------------------------------------------------
+
+    function altitudeFactor(destination, safetyData) {
+        if (!safetyData.HIGH_ALTITUDE_IDS.includes(destination.id)) return null;
+        return {
+            type: "altitude",
+            severity: "caution",
+            delta: -8,
+            message: "High-altitude destination — acclimatize for 24-48 hours before strenuous activity, stay hydrated, and watch for signs of altitude sickness (headache, nausea, dizziness)."
+        };
+    }
+
+    function cycloneFactor(destination, safetyData, monthIndex1to12) {
+        if (!safetyData.CYCLONE_BELT_IDS.includes(destination.id)) return null;
+        if (!safetyData.CYCLONE_MONTHS.includes(monthIndex1to12)) return null;
+        return {
+            type: "cyclone",
+            severity: "caution",
+            delta: -10,
+            message: "Travel falls within the coastal cyclone season for this region — check the India Meteorological Department's latest cyclone bulletins before and during your trip."
+        };
+    }
+
+    function landslideFactor(destination, safetyData, monthIndex1to12) {
+        if (!safetyData.LANDSLIDE_PRONE_IDS.includes(destination.id)) return null;
+        if (!safetyData.MONSOON_MONTHS.includes(monthIndex1to12)) return null;
+        return {
+            type: "landslide",
+            severity: "caution",
+            delta: -10,
+            message: "Monsoon-season travel on hill roads — landslides and road closures are possible. Build buffer time into road transfers and check road-status advisories."
+        };
+    }
+
+    function seismicFactor(destination, safetyData) {
+        if (!safetyData.HIGH_SEISMIC_ZONE_IDS.includes(destination.id)) return null;
+        return {
+            type: "seismic",
+            severity: "info",
+            delta: -4,
+            message: "Located in one of India's higher seismic-activity zones. Not a prediction of an earthquake — just worth knowing your hotel's evacuation route."
+        };
+    }
+
+    function heatFactor(destination, safetyData, monthIndex1to12) {
+        if (!safetyData.EXTREME_HEAT_IDS.includes(destination.id)) return null;
+        if (!safetyData.EXTREME_HEAT_MONTHS.includes(monthIndex1to12)) return null;
+        return {
+            type: "heat",
+            severity: "warning",
+            delta: -8,
+            message: "Peak pre-monsoon heat for this region — plan outdoor activity for early morning/evening, carry extra water, and watch for heat exhaustion symptoms."
+        };
+    }
+
+    function wildlifeFactor(destination, safetyData) {
+        if (!safetyData.WILDLIFE_ENCOUNTER_IDS.includes(destination.id)) return null;
+        return {
+            type: "wildlife",
+            severity: "info",
+            delta: -3,
+            message: "Wildlife-viewing destination — stay inside your vehicle/with your guide at all times and follow park ranger instructions."
+        };
+    }
+
+    /**
+     * @param {Object} weatherSuitability - output of WeatherCore.computeDaySuitability(), or null
+     */
+    function weatherFactor(weatherSuitability) {
+        if (!weatherSuitability || weatherSuitability.status === "good" || weatherSuitability.status === "unknown") return null;
+        const deltas = { caution: -6, poor: -14 };
+        const delta = deltas[weatherSuitability.status] || 0;
+        if (!delta) return null;
+        return {
+            type: "weather",
+            severity: weatherSuitability.status === "poor" ? "warning" : "caution",
+            delta,
+            message: weatherSuitability.reasons && weatherSuitability.reasons.length
+                ? "Forecast concern: " + weatherSuitability.reasons.join(", ") + "."
+                : "Forecast conditions may affect outdoor plans on this day."
+        };
+    }
+
+    /**
+     * @param {Array} quakes - recent nearby earthquakes, e.g. from
+     *   travel-safety-service.js's fetchNearbyEarthquakes(): [{ magnitude, distanceKm, place, time }]
+     */
+    function seismicEventFactor(quakes) {
+        if (!quakes || !quakes.length) return null;
+        const strongest = quakes.reduce((max, q) => (q.magnitude > max.magnitude ? q : max), quakes[0]);
+        if (strongest.magnitude < 4.0) return null;
+        const severity = strongest.magnitude >= 5.5 ? "warning" : "caution";
+        const delta = strongest.magnitude >= 5.5 ? -20 : -10;
+        return {
+            type: "seismic-event",
+            severity,
+            delta,
+            message: `Recent magnitude ${strongest.magnitude.toFixed(1)} earthquake reported near ${strongest.place} (within the last 30 days). Check local authority updates before travel.`
+        };
+    }
+
+    // ------------------------------------------------------------------
+    // Score assembly
+    // ------------------------------------------------------------------
+
+    /**
+     * @param {Object} destination - a trip-data.js destination ({ id, categories, ... })
+     * @param {Object} safetyData - window.SafetyData (or an injected equivalent)
+     * @param {Object} [context]
+     * @param {Object} [context.weatherSuitability] - WeatherCore.computeDaySuitability() output
+     * @param {Array}  [context.quakes] - recent earthquakes near this destination
+     * @param {Date}   [context.date] - date being assessed (defaults to now); drives seasonal factors
+     * @returns {{score:number, level:string, label:string, color:string, factors:Array}}
+     */
+    function computeDestinationSafetyScore(destination, safetyData, context) {
+        if (!destination) throw new Error("computeDestinationSafetyScore: destination is required");
+        context = context || {};
+        const date = context.date instanceof Date ? context.date : new Date();
+        const month = date.getMonth() + 1;
+
+        const base = safetyData.baseScoreForDestination(destination);
+        const factors = [
+            altitudeFactor(destination, safetyData),
+            cycloneFactor(destination, safetyData, month),
+            landslideFactor(destination, safetyData, month),
+            seismicFactor(destination, safetyData),
+            heatFactor(destination, safetyData, month),
+            wildlifeFactor(destination, safetyData),
+            weatherFactor(context.weatherSuitability),
+            seismicEventFactor(context.quakes)
+        ].filter(Boolean);
+
+        const totalDelta = factors.reduce((sum, f) => sum + f.delta, 0);
+        const classification = classifyScore(base + totalDelta);
+
+        return Object.assign({}, classification, { baseScore: base, factors });
+    }
+
+    // ------------------------------------------------------------------
+    // Advisories — human-readable list derived straight from factors,
+    // sorted worst-first so the most important item is always on top.
+    // ------------------------------------------------------------------
+    const SEVERITY_RANK = { warning: 0, caution: 1, info: 2 };
+
+    function buildAdvisories(assessment) {
+        return assessment.factors
+            .slice()
+            .sort((a, b) => SEVERITY_RANK[a.severity] - SEVERITY_RANK[b.severity])
+            .map((f) => ({ severity: f.severity, type: f.type, message: f.message }));
+    }
+
+    // ------------------------------------------------------------------
+    // Personalized checklist — base list + destination-specific items
+    // pulled in from whichever factors are active.
+    // ------------------------------------------------------------------
+    function buildSafetyChecklist(destination, safetyData, assessment) {
+        const items = safetyData.BASE_SAFETY_CHECKLIST.slice();
+        const activeTypes = new Set((assessment && assessment.factors ? assessment.factors : []).map((f) => f.type));
+
+        if (activeTypes.has("altitude")) {
+            items.push({ id: "altitude-plan", label: "Schedule a low-activity acclimatization day on arrival", category: "before" });
+        }
+        if (activeTypes.has("cyclone")) {
+            items.push({ id: "cyclone-watch", label: "Check IMD cyclone bulletins in the days before departure", category: "before" });
+        }
+        if (activeTypes.has("landslide")) {
+            items.push({ id: "road-status", label: "Confirm hill-road status the morning of any road transfer", category: "during" });
+        }
+        if (activeTypes.has("heat")) {
+            items.push({ id: "heat-plan", label: "Schedule outdoor sightseeing for early morning or evening", category: "during" });
+        }
+        if (activeTypes.has("wildlife")) {
+            items.push({ id: "wildlife-rules", label: "Confirm park/safari safety briefing before entering", category: "during" });
+        }
+        if (destination && destination.categories && destination.categories.includes("beaches")) {
+            items.push({ id: "water-safety", label: "Swim only at flagged/lifeguarded beaches", category: "during" });
+        }
+        return items;
+    }
+
+    // ------------------------------------------------------------------
+    // Itinerary-wide evaluation — mirrors weather-core.js's
+    // evaluateItineraryWeather() shape so the two can share UI patterns.
+    // ------------------------------------------------------------------
+
+    /**
+     * @param {Array} schedule - output of TripPlanner.buildDailySchedule()
+     * @param {Object} destinationsById - { [destId]: destination }
+     * @param {Object} safetyData
+     * @param {Object} liveContext - { forecastsByDestId, quakesByDestId }
+     * @param {string} tripStartDateISO - "YYYY-MM-DD"
+     */
+    function evaluateItinerarySafety(schedule, destinationsById, safetyData, liveContext, tripStartDateISO, weatherCore) {
+        const start = new Date(tripStartDateISO + "T00:00:00");
+        if (isNaN(start.getTime())) {
+            throw new Error("evaluateItinerarySafety: invalid tripStartDateISO");
+        }
+        const forecastsByDestId = (liveContext && liveContext.forecastsByDestId) || {};
+        const quakesByDestId = (liveContext && liveContext.quakesByDestId) || {};
+
+        return schedule.map((item) => {
+            const date = addDaysISO(start, item.day - 1);
+            if (item.type !== "stay") {
+                return Object.assign({}, item, { date });
+            }
+            const dest = destinationsById[item.destId] || null;
+            if (!dest) return Object.assign({}, item, { date, assessment: null });
+
+            let weatherSuitability = null;
+            if (weatherCore && forecastsByDestId[dest.id]) {
+                const forecastDay = forecastsByDestId[dest.id].find((f) => f.date === date) || null;
+                weatherSuitability = weatherCore.computeDaySuitability(forecastDay, dest.categories);
+            }
+
+            const assessment = computeDestinationSafetyScore(dest, safetyData, {
+                weatherSuitability,
+                quakes: quakesByDestId[dest.id] || [],
+                date: new Date(date + "T00:00:00")
+            });
+
+            return Object.assign({}, item, { date, assessment });
+        });
+    }
+
+    function addDaysISO(startDate, offset) {
+        const d = new Date(startDate);
+        d.setDate(d.getDate() + offset);
+        const yyyy = d.getFullYear();
+        const mm = String(d.getMonth() + 1).padStart(2, "0");
+        const dd = String(d.getDate()).padStart(2, "0");
+        return `${yyyy}-${mm}-${dd}`;
+    }
+
+    /**
+     * Notification-ready alerts for destinations in an itinerary — the
+     * "alert notifications for itinerary destinations" acceptance
+     * criterion. Only surfaces stay-days with a caution/warning factor,
+     * de-duplicated per destination (one alert per city, not per day).
+     *
+     * @param {Array} evaluatedSchedule - output of evaluateItinerarySafety()
+     * @returns {Array<{destId, city, date, level, headline, factors}>}
+     */
+    function buildItineraryAlerts(evaluatedSchedule) {
+        const seen = new Set();
+        const alerts = [];
+        evaluatedSchedule.forEach((item) => {
+            if (item.type !== "stay" || !item.assessment) return;
+            const notable = item.assessment.factors.filter((f) => f.severity !== "info");
+            if (!notable.length) return;
+            const key = item.destId + ":" + notable.map((f) => f.type).sort().join(",");
+            if (seen.has(key)) return;
+            seen.add(key);
+            alerts.push({
+                destId: item.destId,
+                city: item.city,
+                date: item.date,
+                level: item.assessment.level,
+                headline: notable[0].message,
+                factors: notable
+            });
+        });
+        return alerts;
+    }
+
+    const api = {
+        RISK_LEVELS,
+        classifyScore,
+        altitudeFactor,
+        cycloneFactor,
+        landslideFactor,
+        seismicFactor,
+        heatFactor,
+        wildlifeFactor,
+        weatherFactor,
+        seismicEventFactor,
+        computeDestinationSafetyScore,
+        buildAdvisories,
+        buildSafetyChecklist,
+        evaluateItinerarySafety,
+        buildItineraryAlerts
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.TravelSafetyCore = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
diff --git a/js-modules/travel-safety-service.js b/js-modules/travel-safety-service.js
new file mode 100644
index 0000000..e50466f
--- /dev/null
+++ b/js-modules/travel-safety-service.js
@@ -0,0 +1,237 @@
+/**
+ * js-modules/travel-safety-service.js
+ * Live-data fetch/cache layer for the Intelligent Travel Risk Assessment
+ * & Safety Advisory System (issue #772).
+ *
+ * Same "no backend" approach as weather-service.js: free, no-API-key
+ * public endpoints, responses cached in localStorage with a TTL so a
+ * repeat visit to the same destination doesn't re-hit a shared public
+ * resource. DOM/network-facing by design — kept separate from
+ * travel-safety-core.js so the scoring/advisory rules stay unit-testable
+ * without mocking fetch.
+ *
+ * Data sources:
+ *  - Earthquakes: USGS Earthquake Hazards Program FDSN event API
+ *    (https://earthquake.usgs.gov/fdsnws/event/1/), public, no key.
+ *  - Nearby hospitals/police: OpenStreetMap Overpass API
+ *    (https://overpass-api.de/api/interpreter), public, no key — the
+ *    same open geodata source the project's route planner already
+ *    trusts (see docs/ROUTE_PLANNER.md, which uses OSRM/OSM data).
+ *  - Weather risk reuses window.WeatherService (weather-service.js) —
+ *    not duplicated here.
+ */
+(function (root) {
+    "use strict";
+
+    const QUAKE_CACHE_PREFIX = "safetyQuakeCache:";
+    const QUAKE_CACHE_TTL_MS = 6 * 60 * 60 * 1000; // 6 hours
+    const QUAKE_RADIUS_KM = 300;
+    const QUAKE_LOOKBACK_DAYS = 30;
+    const QUAKE_MIN_MAGNITUDE = 3.5;
+
+    const PLACES_CACHE_PREFIX = "safetyPlacesCache:";
+    const PLACES_CACHE_TTL_MS = 7 * 24 * 60 * 60 * 1000; // 7 days — hospitals/police stations rarely move
+    const PLACES_RADIUS_M = 8000;
+    const PLACES_LIMIT = 5;
+
+    function readCache(prefix, key, ttlMs) {
+        try {
+            const raw = localStorage.getItem(prefix + key);
+            if (!raw) return null;
+            const parsed = JSON.parse(raw);
+            if (!parsed || typeof parsed.fetchedAt !== "number") return null;
+            if (Date.now() - parsed.fetchedAt > ttlMs) return null;
+            return parsed.data;
+        } catch (e) {
+            return null;
+        }
+    }
+
+    function writeCache(prefix, key, data) {
+        try {
+            localStorage.setItem(prefix + key, JSON.stringify({ fetchedAt: Date.now(), data }));
+        } catch (e) {
+            // Storage full/unavailable — just won't be cached this session.
+        }
+    }
+
+    function coordKey(lat, lng) {
+        return lat.toFixed(2) + ":" + lng.toFixed(2);
+    }
+
+    // ------------------------------------------------------------------
+    // Earthquakes (USGS)
+    // ------------------------------------------------------------------
+    function haversineDistanceKm(lat1, lng1, lat2, lng2) {
+        const R = 6371;
+        const dLat = ((lat2 - lat1) * Math.PI) / 180;
+        const dLng = ((lng2 - lng1) * Math.PI) / 180;
+        const a =
+            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
+            Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
+        return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
+    }
+
+    function buildQuakeUrl(lat, lng) {
+        const end = new Date();
+        const start = new Date(end.getTime() - QUAKE_LOOKBACK_DAYS * 24 * 60 * 60 * 1000);
+        const params = new URLSearchParams({
+            format: "geojson",
+            starttime: start.toISOString().slice(0, 10),
+            endtime: end.toISOString().slice(0, 10),
+            latitude: lat,
+            longitude: lng,
+            maxradiuskm: String(QUAKE_RADIUS_KM),
+            minmagnitude: String(QUAKE_MIN_MAGNITUDE),
+            orderby: "magnitude"
+        });
+        return "https://earthquake.usgs.gov/fdsnws/event/1/query?" + params.toString();
+    }
+
+    function normalizeQuakeResponse(json, lat, lng) {
+        const features = (json && json.features) || [];
+        return features
+            .map((f) => {
+                const props = f.properties || {};
+                const coords = (f.geometry && f.geometry.coordinates) || [];
+                const [qLng, qLat] = coords;
+                if (typeof qLat !== "number" || typeof qLng !== "number") return null;
+                return {
+                    magnitude: props.mag,
+                    place: props.place || "nearby",
+                    time: props.time ? new Date(props.time).toISOString() : null,
+                    distanceKm: Math.round(haversineDistanceKm(lat, lng, qLat, qLng))
+                };
+            })
+            .filter(Boolean)
+            .sort((a, b) => b.magnitude - a.magnitude);
+    }
+
+    /** Fetch (or reuse cached) recent nearby earthquakes for one lat/lng. */
+    async function fetchNearbyEarthquakes(lat, lng) {
+        const key = coordKey(lat, lng);
+        const cached = readCache(QUAKE_CACHE_PREFIX, key, QUAKE_CACHE_TTL_MS);
+        if (cached) return cached;
+
+        const res = await fetch(buildQuakeUrl(lat, lng));
+        if (!res.ok) {
+            throw new Error("Earthquake API responded with status " + res.status);
+        }
+        const json = await res.json();
+        const quakes = normalizeQuakeResponse(json, lat, lng);
+        writeCache(QUAKE_CACHE_PREFIX, key, quakes);
+        return quakes;
+    }
+
+    // ------------------------------------------------------------------
+    // Nearby hospitals/police (OpenStreetMap Overpass API)
+    // ------------------------------------------------------------------
+    function buildOverpassQuery(lat, lng, radiusM) {
+        return `[out:json][timeout:15];(
+            node["amenity"="hospital"](around:${radiusM},${lat},${lng});
+            node["amenity"="police"](around:${radiusM},${lat},${lng});
+        );out center ${PLACES_LIMIT * 4};`;
+    }
+
+    function normalizePlacesResponse(json, lat, lng) {
+        const elements = (json && json.elements) || [];
+        const byType = { hospital: [], police: [] };
+        elements.forEach((el) => {
+            const tags = el.tags || {};
+            const type = tags.amenity;
+            if (type !== "hospital" && type !== "police") return;
+            const elLat = el.lat, elLng = el.lon;
+            if (typeof elLat !== "number" || typeof elLng !== "number") return;
+            byType[type].push({
+                name: tags.name || (type === "hospital" ? "Unnamed hospital" : "Unnamed police station"),
+                distanceKm: Math.round(haversineDistanceKm(lat, lng, elLat, elLng) * 10) / 10,
+                phone: tags.phone || tags["contact:phone"] || null,
+                lat: elLat,
+                lng: elLng
+            });
+        });
+        byType.hospital.sort((a, b) => a.distanceKm - b.distanceKm);
+        byType.police.sort((a, b) => a.distanceKm - b.distanceKm);
+        return {
+            hospitals: byType.hospital.slice(0, PLACES_LIMIT),
+            police: byType.police.slice(0, PLACES_LIMIT)
+        };
+    }
+
+    /** Fetch (or reuse cached) nearby hospitals/police for one lat/lng. */
+    async function fetchNearbyEmergencyPlaces(lat, lng) {
+        const key = coordKey(lat, lng);
+        const cached = readCache(PLACES_CACHE_PREFIX, key, PLACES_CACHE_TTL_MS);
+        if (cached) return cached;
+
+        const res = await fetch("https://overpass-api.de/api/interpreter", {
+            method: "POST",
+            body: buildOverpassQuery(lat, lng, PLACES_RADIUS_M)
+        });
+        if (!res.ok) {
+            throw new Error("Overpass API responded with status " + res.status);
+        }
+        const json = await res.json();
+        const places = normalizePlacesResponse(json, lat, lng);
+        writeCache(PLACES_CACHE_PREFIX, key, places);
+        return places;
+    }
+
+    // ------------------------------------------------------------------
+    // Combined fetch for a set of destinations — mirrors
+    // weather-service.js's fetchForecastsForDestinations(): failures are
+    // isolated per-destination/per-source so one bad lookup doesn't
+    // break the whole assessment.
+    //
+    // @returns {Promise<{quakesByDestId, placesByDestId, failed}>}
+    // ------------------------------------------------------------------
+    async function fetchSafetyContextForDestinations(destinations) {
+        const quakesByDestId = {};
+        const placesByDestId = {};
+        const failed = [];
+
+        const results = await Promise.allSettled(
+            destinations.map((d) =>
+                Promise.all([fetchNearbyEarthquakes(d.lat, d.lng), fetchNearbyEmergencyPlaces(d.lat, d.lng)]).then(
+                    ([quakes, places]) => ({ id: d.id, quakes, places })
+                )
+            )
+        );
+
+        results.forEach((result, i) => {
+            const dest = destinations[i];
+            if (result.status === "fulfilled") {
+                quakesByDestId[result.value.id] = result.value.quakes;
+                placesByDestId[result.value.id] = result.value.places;
+            } else {
+                failed.push({ id: dest.id, name: dest.name, error: result.reason ? result.reason.message : "Unknown error" });
+            }
+        });
+
+        return { quakesByDestId, placesByDestId, failed };
+    }
+
+    const api = {
+        QUAKE_CACHE_TTL_MS,
+        QUAKE_RADIUS_KM,
+        PLACES_CACHE_TTL_MS,
+        PLACES_RADIUS_M,
+        buildQuakeUrl,
+        normalizeQuakeResponse,
+        fetchNearbyEarthquakes,
+        buildOverpassQuery,
+        normalizePlacesResponse,
+        fetchNearbyEmergencyPlaces,
+        fetchSafetyContextForDestinations,
+        haversineDistanceKm,
+        _readCache: readCache,
+        _writeCache: writeCache
+    };
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = api;
+    }
+    if (typeof window !== "undefined") {
+        window.TravelSafetyService = api;
+    }
+})(typeof window !== "undefined" ? window : globalThis);
diff --git a/js-modules/travel-safety-ui.js b/js-modules/travel-safety-ui.js
new file mode 100644
index 0000000..1dd8758
--- /dev/null
+++ b/js-modules/travel-safety-ui.js
@@ -0,0 +1,319 @@
+/**
+ * js-modules/travel-safety-ui.js
+ * DOM layer for the Intelligent Travel Risk Assessment & Safety Advisory
+ * page (frontend/travel-safety/travel-safety.html, issue #772).
+ *
+ * Wires together:
+ *  - safety-data.js       (static hazard tables + emergency contacts)
+ *  - travel-safety-core.js (pure scoring/advisory/checklist rules)
+ *  - travel-safety-service.js (live earthquake + nearby hospital/police fetch)
+ *  - weather-core.js / weather-service.js (weather risk factor — reused,
+ *    not duplicated; degrades gracefully if a forecast fails)
+ *  - trip-data.js          (destination catalogue, shared with Trip Planner)
+ *  - trip-planner.js       (reads saved trips for the itinerary-alerts view)
+ *
+ * Registered in router-init.js for travel-safety.html, called as
+ * initTravelSafetyPage() the same way other page modules are.
+ */
+(function () {
+    "use strict";
+
+    function initTravelSafetyPage() {
+        const SafetyData = window.SafetyData;
+        const Core = window.TravelSafetyCore;
+        const Service = window.TravelSafetyService;
+        const WeatherCore = window.WeatherCore;
+        const WeatherService = window.WeatherService;
+        const destinations = window.tripDestinations || [];
+
+        if (!SafetyData || !Core || !Service || !destinations.length) {
+            console.error("[TravelSafetyUI] Missing dependency (SafetyData/TravelSafetyCore/TravelSafetyService/tripDestinations) — safety page disabled.");
+            return;
+        }
+
+        const destinationsById = {};
+        destinations.forEach((d) => { destinationsById[d.id] = d; });
+        const destinationsByName = {};
+        destinations.forEach((d) => { destinationsByName[d.name] = d; });
+
+        const CHECKLIST_KEY_PREFIX = "travelSafetyChecklist:";
+
+        // -- DOM refs -----------------------------------------------------
+        const select = document.getElementById("safety-destination-select");
+        const checkBtn = document.getElementById("safety-check-btn");
+        const resultPanel = document.getElementById("safety-result-panel");
+        const contactsPanel = document.getElementById("safety-contacts-panel");
+        const tripSelect = document.getElementById("safety-trip-select");
+        const tripCheckBtn = document.getElementById("safety-trip-check-btn");
+        const tripAlertsPanel = document.getElementById("safety-trip-alerts-panel");
+
+        if (!select || !resultPanel) return; // page markup not present — nothing to wire up
+
+        // -- Populate destination picker -----------------------------------
+        destinations
+            .slice()
+            .sort((a, b) => a.name.localeCompare(b.name))
+            .forEach((d) => {
+                const opt = document.createElement("option");
+                opt.value = d.id;
+                opt.textContent = `${d.name}, ${d.state}`;
+                select.appendChild(opt);
+            });
+
+        // -- Render national emergency contacts (always visible) -----------
+        if (contactsPanel) {
+            contactsPanel.innerHTML = renderEmergencyContacts(SafetyData.NATIONAL_EMERGENCY_CONTACTS);
+        }
+
+        // -- Populate saved-trip picker, if any ----------------------------
+        function refreshSavedTrips() {
+            if (!tripSelect || !window.TripPlanner) return;
+            const trips = window.TripPlanner.getSavedTrips();
+            tripSelect.innerHTML = "";
+            if (!trips.length) {
+                const opt = document.createElement("option");
+                opt.textContent = "No saved trips yet — plan one in Trip Planner";
+                opt.disabled = true;
+                tripSelect.appendChild(opt);
+                if (tripCheckBtn) tripCheckBtn.disabled = true;
+                return;
+            }
+            trips.forEach((t) => {
+                const opt = document.createElement("option");
+                opt.value = t.id;
+                opt.textContent = t.title;
+                tripSelect.appendChild(opt);
+            });
+            if (tripCheckBtn) tripCheckBtn.disabled = false;
+        }
+        refreshSavedTrips();
+
+        // -- Single-destination check --------------------------------------
+        let requestToken = 0;
+
+        async function checkDestination(destId) {
+            const destination = destinationsById[destId];
+            if (!destination) return;
+
+            const myToken = ++requestToken;
+            resultPanel.hidden = false;
+            resultPanel.innerHTML = renderLoading(`Checking safety data for ${destination.name}…`);
+
+            let quakes = [];
+            let places = { hospitals: [], police: [] };
+            let weatherSuitability = null;
+
+            try {
+                const [safetyContext, weatherResult] = await Promise.allSettled([
+                    Promise.all([Service.fetchNearbyEarthquakes(destination.lat, destination.lng), Service.fetchNearbyEmergencyPlaces(destination.lat, destination.lng)]),
+                    WeatherService ? WeatherService.fetchForecast(destination.lat, destination.lng) : Promise.resolve(null)
+                ]);
+
+                if (myToken !== requestToken) return;
+
+                if (safetyContext.status === "fulfilled") {
+                    [quakes, places] = safetyContext.value;
+                }
+                if (weatherResult.status === "fulfilled" && weatherResult.value && WeatherCore) {
+                    const today = new Date().toISOString().slice(0, 10);
+                    const todayForecast = weatherResult.value.find((f) => f.date === today) || weatherResult.value[0] || null;
+                    weatherSuitability = WeatherCore.computeDaySuitability(todayForecast, destination.categories);
+                }
+            } catch (err) {
+                // Individual sources already isolated above; this only
+                // catches something unexpected — assessment still proceeds
+                // with whatever data we have.
+                console.warn("[TravelSafetyUI] Partial data failure", err);
+            }
+
+            if (myToken !== requestToken) return;
+
+            const assessment = Core.computeDestinationSafetyScore(destination, SafetyData, { weatherSuitability, quakes });
+            const advisories = Core.buildAdvisories(assessment);
+            const checklist = Core.buildSafetyChecklist(destination, SafetyData, assessment);
+            const checkedIds = loadChecklistState(destId);
+
+            resultPanel.innerHTML = renderResult(destination, assessment, advisories, checklist, checkedIds, places);
+            wireChecklist(destId, resultPanel);
+        }
+
+        // -- Itinerary-wide check --------------------------------------------
+        async function checkTrip(tripId) {
+            if (!window.TripPlanner) return;
+            const trips = window.TripPlanner.getSavedTrips();
+            const trip = trips.find((t) => t.id === tripId);
+            if (!trip || !tripAlertsPanel) return;
+
+            tripAlertsPanel.hidden = false;
+            tripAlertsPanel.innerHTML = renderLoading("Checking safety data for every stop on this trip…");
+
+            const tripDestinations = trip.itinerary.destinations
+                .map((d) => destinationsByName[d.name])
+                .filter(Boolean);
+
+            if (!tripDestinations.length) {
+                tripAlertsPanel.innerHTML = "<p>Couldn't match this trip's destinations to the safety database.</p>";
+                return;
+            }
+
+            let quakesByDestId = {};
+            try {
+                const result = await Service.fetchSafetyContextForDestinations(tripDestinations);
+                quakesByDestId = result.quakesByDestId;
+            } catch (err) {
+                console.warn("[TravelSafetyUI] Itinerary earthquake lookup failed", err);
+            }
+
+            const schedule = window.TripPlanner.buildDailySchedule(trip.itinerary).map((item) => {
+                if (item.type !== "stay") return item;
+                const dest = destinationsByName[item.city];
+                return Object.assign({}, item, { destId: dest ? dest.id : null });
+            });
+
+            const startDate = new Date().toISOString().slice(0, 10); // saved trips don't store a start date, so alerts use today + relative day offsets
+            const evaluated = Core.evaluateItinerarySafety(schedule, destinationsById, SafetyData, { quakesByDestId }, startDate, WeatherCore);
+            const alerts = Core.buildItineraryAlerts(evaluated);
+
+            tripAlertsPanel.innerHTML = renderTripAlerts(trip, alerts);
+        }
+
+        // -- Checklist persistence -------------------------------------------
+        function loadChecklistState(destId) {
+            try {
+                const raw = localStorage.getItem(CHECKLIST_KEY_PREFIX + destId);
+                return raw ? new Set(JSON.parse(raw)) : new Set();
+            } catch (e) {
+                return new Set();
+            }
+        }
+        function saveChecklistState(destId, checkedIds) {
+            try {
+                localStorage.setItem(CHECKLIST_KEY_PREFIX + destId, JSON.stringify(Array.from(checkedIds)));
+            } catch (e) { /* storage unavailable — checklist just won't persist */ }
+        }
+        function wireChecklist(destId, container) {
+            const boxes = container.querySelectorAll("[data-checklist-item]");
+            boxes.forEach((box) => {
+                box.addEventListener("change", () => {
+                    const checked = loadChecklistState(destId);
+                    if (box.checked) checked.add(box.dataset.checklistItem);
+                    else checked.delete(box.dataset.checklistItem);
+                    saveChecklistState(destId, checked);
+                });
+            });
+        }
+
+        // -- Rendering ---------------------------------------------------------
+        function renderLoading(message) {
+            return `<div class="safety-loading"><span class="safety-spinner" aria-hidden="true"></span>${escapeHtml(message)}</div>`;
+        }
+
+        function renderEmergencyContacts(contacts) {
+            return `
+                <h3>National Emergency Contacts</h3>
+                <ul class="safety-contacts-list">
+                    ${contacts.map((c) => `
+                        <li>
+                            <span class="safety-contact-label">${escapeHtml(c.label)}</span>
+                            <span class="safety-contact-number">${escapeHtml(c.number)}${c.altNumber ? " / " + escapeHtml(c.altNumber) : ""}</span>
+                            ${c.note ? `<span class="safety-contact-note">${escapeHtml(c.note)}</span>` : ""}
+                        </li>
+                    `).join("")}
+                </ul>`;
+        }
+
+        function severityIcon(sev) {
+            return { warning: "⚠️", caution: "🟡", info: "ℹ️" }[sev] || "•";
+        }
+
+        function renderResult(destination, assessment, advisories, checklist, checkedIds, places) {
+            const grouped = { before: [], during: [] };
+            checklist.forEach((item) => grouped[item.category || "before"].push(item));
+
+            return `
+                <div class="safety-score-card safety-level-${assessment.level}">
+                    <div class="safety-score-value">${assessment.score}<span>/100</span></div>
+                    <div class="safety-score-meta">
+                        <h3>${escapeHtml(destination.name)}, ${escapeHtml(destination.state)}</h3>
+                        <span class="safety-level-badge">${escapeHtml(assessment.label)}</span>
+                    </div>
+                </div>
+
+                <section class="safety-advisories">
+                    <h4>Travel Advisories</h4>
+                    ${advisories.length
+                        ? `<ul>${advisories.map((a) => `<li class="safety-advisory safety-sev-${a.severity}">${severityIcon(a.severity)} ${escapeHtml(a.message)}</li>`).join("")}</ul>`
+                        : `<p class="safety-no-advisories">No elevated risk factors detected for this destination right now.</p>`}
+                </section>
+
+                <section class="safety-nearby">
+                    <h4>Nearby (live, OpenStreetMap)</h4>
+                    <div class="safety-nearby-grid">
+                        <div>
+                            <h5>🏥 Hospitals</h5>
+                            ${places.hospitals.length
+                                ? `<ul>${places.hospitals.map((h) => `<li>${escapeHtml(h.name)} — ${h.distanceKm} km${h.phone ? " · " + escapeHtml(h.phone) : ""}</li>`).join("")}</ul>`
+                                : "<p>None found within range in OpenStreetMap's data for this area.</p>"}
+                        </div>
+                        <div>
+                            <h5>🚓 Police Stations</h5>
+                            ${places.police.length
+                                ? `<ul>${places.police.map((p) => `<li>${escapeHtml(p.name)} — ${p.distanceKm} km${p.phone ? " · " + escapeHtml(p.phone) : ""}</li>`).join("")}</ul>`
+                                : "<p>None found within range in OpenStreetMap's data for this area.</p>"}
+                        </div>
+                    </div>
+                </section>
+
+                <section class="safety-checklist">
+                    <h4>Safety Checklist</h4>
+                    <h5>Before you go</h5>
+                    <ul>${grouped.before.map((item) => renderChecklistItem(item, checkedIds)).join("")}</ul>
+                    <h5>During your trip</h5>
+                    <ul>${grouped.during.map((item) => renderChecklistItem(item, checkedIds)).join("")}</ul>
+                </section>
+            `;
+        }
+
+        function renderChecklistItem(item, checkedIds) {
+            const checked = checkedIds.has(item.id) ? "checked" : "";
+            return `<li><label><input type="checkbox" data-checklist-item="${escapeHtml(item.id)}" ${checked}/> ${escapeHtml(item.label)}</label></li>`;
+        }
+
+        function renderTripAlerts(trip, alerts) {
+            if (!alerts.length) {
+                return `<p class="safety-no-advisories">No elevated risk factors detected across "${escapeHtml(trip.title)}".</p>`;
+            }
+            return `
+                <h4>Alerts for "${escapeHtml(trip.title)}"</h4>
+                <ul class="safety-trip-alerts">
+                    ${alerts.map((a) => `
+                        <li class="safety-advisory safety-level-${a.level}">
+                            <strong>${escapeHtml(a.city)}</strong> (${escapeHtml(a.date)}): ${escapeHtml(a.headline)}
+                        </li>
+                    `).join("")}
+                </ul>`;
+        }
+
+        function escapeHtml(str) {
+            return String(str).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
+        }
+
+        // -- Event wiring --------------------------------------------------
+        if (checkBtn) {
+            checkBtn.addEventListener("click", () => {
+                if (select.value) checkDestination(select.value);
+            });
+        }
+        if (tripCheckBtn) {
+            tripCheckBtn.addEventListener("click", () => {
+                if (tripSelect && tripSelect.value) checkTrip(tripSelect.value);
+            });
+        }
+    }
+
+    window.initTravelSafetyPage = initTravelSafetyPage;
+
+    if (typeof module !== "undefined" && module.exports) {
+        module.exports = { initTravelSafetyPage };
+    }
+})();
diff --git a/tests/unit/travel-safety-core.test.js b/tests/unit/travel-safety-core.test.js
new file mode 100644
index 0000000..3b9932e
--- /dev/null
+++ b/tests/unit/travel-safety-core.test.js
@@ -0,0 +1,233 @@
+/**
+ * travel-safety-core.test.js
+ * Tests for js-modules/travel-safety-core.js — the pure rule-based
+ * scoring, advisory, checklist, and itinerary-alert logic behind the
+ * Intelligent Travel Risk Assessment & Safety Advisory System (issue #772).
+ */
+
+import { describe, it, expect } from 'vitest';
+import Core from '../../js-modules/travel-safety-core.js';
+import SafetyData from '../../js-modules/safety-data.js';
+import WeatherCore from '../../js-modules/weather-core.js';
+
+function destination(overrides) {
+    return Object.assign({
+        id: 'agra',
+        name: 'Agra',
+        state: 'Uttar Pradesh',
+        lat: 27.1767,
+        lng: 78.0081,
+        categories: ['historical', 'heritage']
+    }, overrides);
+}
+
+describe('travel-safety-core: classifyScore', () => {
+    it('classifies a high score as low risk', () => {
+        expect(Core.classifyScore(92).level).toBe('low');
+    });
+
+    it('classifies a mid score as moderate risk', () => {
+        expect(Core.classifyScore(70).level).toBe('moderate');
+    });
+
+    it('classifies a low score as elevated risk', () => {
+        expect(Core.classifyScore(45).level).toBe('elevated');
+    });
+
+    it('classifies a very low score as high risk', () => {
+        expect(Core.classifyScore(10).level).toBe('high');
+    });
+
+    it('clamps out-of-range scores', () => {
+        expect(Core.classifyScore(150).score).toBe(100);
+        expect(Core.classifyScore(-50).score).toBe(0);
+    });
+});
+
+describe('travel-safety-core: hazard factors', () => {
+    it('flags a high-altitude destination', () => {
+        const factor = Core.altitudeFactor(destination({ id: 'leh' }), SafetyData);
+        expect(factor).not.toBeNull();
+        expect(factor.type).toBe('altitude');
+        expect(factor.delta).toBeLessThan(0);
+    });
+
+    it('does not flag altitude for a low-altitude destination', () => {
+        expect(Core.altitudeFactor(destination({ id: 'agra' }), SafetyData)).toBeNull();
+    });
+
+    it('flags cyclone risk only in-season for coastal destinations', () => {
+        const dest = destination({ id: 'goa' });
+        expect(Core.cycloneFactor(dest, SafetyData, 5)).not.toBeNull(); // May: in season
+        expect(Core.cycloneFactor(dest, SafetyData, 1)).toBeNull(); // January: out of season
+    });
+
+    it('does not flag cyclone risk for a non-coastal destination', () => {
+        expect(Core.cycloneFactor(destination({ id: 'agra' }), SafetyData, 5)).toBeNull();
+    });
+
+    it('flags landslide risk only during monsoon months for hill destinations', () => {
+        const dest = destination({ id: 'manali' });
+        expect(Core.landslideFactor(dest, SafetyData, 7)).not.toBeNull(); // July: monsoon
+        expect(Core.landslideFactor(dest, SafetyData, 12)).toBeNull(); // December: dry season
+    });
+
+    it('flags extreme heat only in-season for desert destinations', () => {
+        const dest = destination({ id: 'jaisalmer' });
+        expect(Core.heatFactor(dest, SafetyData, 5)).not.toBeNull(); // May: peak heat
+        expect(Core.heatFactor(dest, SafetyData, 12)).toBeNull(); // December: mild
+    });
+
+    it('flags wildlife destinations', () => {
+        expect(Core.wildlifeFactor(destination({ id: 'kaziranga' }), SafetyData)).not.toBeNull();
+        expect(Core.wildlifeFactor(destination({ id: 'agra' }), SafetyData)).toBeNull();
+    });
+
+    it('translates poor weather suitability into a risk factor', () => {
+        const suitability = { status: 'poor', reasons: ['heavy rain expected'] };
+        const factor = Core.weatherFactor(suitability);
+        expect(factor.severity).toBe('warning');
+        expect(factor.delta).toBeLessThan(-10);
+    });
+
+    it('does not add a weather factor for good weather', () => {
+        expect(Core.weatherFactor({ status: 'good', reasons: [] })).toBeNull();
+        expect(Core.weatherFactor(null)).toBeNull();
+    });
+
+    it('flags a significant recent nearby earthquake', () => {
+        const quakes = [{ magnitude: 5.8, place: '50km N of Test', distanceKm: 50 }];
+        const factor = Core.seismicEventFactor(quakes);
+        expect(factor.severity).toBe('warning');
+    });
+
+    it('ignores minor earthquakes below the threshold', () => {
+        const quakes = [{ magnitude: 2.1, place: 'Test', distanceKm: 10 }];
+        expect(Core.seismicEventFactor(quakes)).toBeNull();
+    });
+
+    it('handles an empty quake list', () => {
+        expect(Core.seismicEventFactor([])).toBeNull();
+    });
+});
+
+describe('travel-safety-core: computeDestinationSafetyScore', () => {
+    it('gives a low-hazard city a high, low-risk score with no context', () => {
+        const assessment = Core.computeDestinationSafetyScore(destination({ id: 'agra' }), SafetyData, {});
+        expect(assessment.score).toBeGreaterThan(70);
+        expect(['low', 'moderate']).toContain(assessment.level);
+    });
+
+    it('lowers the score for a high-altitude destination', () => {
+        const withoutHazard = Core.computeDestinationSafetyScore(destination({ id: 'agra' }), SafetyData, {});
+        const withHazard = Core.computeDestinationSafetyScore(destination({ id: 'leh', categories: ['mountains'] }), SafetyData, {});
+        expect(withHazard.score).toBeLessThan(withoutHazard.score);
+    });
+
+    it('stacks multiple factors (weather + seismic event) for a bigger drop', () => {
+        const dest = destination({ id: 'leh', categories: ['mountains'] });
+        const onlyBase = Core.computeDestinationSafetyScore(dest, SafetyData, {});
+        const withExtra = Core.computeDestinationSafetyScore(dest, SafetyData, {
+            weatherSuitability: { status: 'poor', reasons: ['heavy snow fall expected'] },
+            quakes: [{ magnitude: 6.0, place: 'near Leh', distanceKm: 20 }]
+        });
+        expect(withExtra.score).toBeLessThan(onlyBase.score);
+        expect(withExtra.factors.length).toBeGreaterThan(onlyBase.factors.length);
+    });
+
+    it('throws when no destination is given', () => {
+        expect(() => Core.computeDestinationSafetyScore(null, SafetyData, {})).toThrow();
+    });
+});
+
+describe('travel-safety-core: buildAdvisories', () => {
+    it('sorts advisories with warnings before cautions before info', () => {
+        const assessment = {
+            factors: [
+                { type: 'a', severity: 'info', message: 'info msg' },
+                { type: 'b', severity: 'warning', message: 'warning msg' },
+                { type: 'c', severity: 'caution', message: 'caution msg' }
+            ]
+        };
+        const advisories = Core.buildAdvisories(assessment);
+        expect(advisories.map((a) => a.severity)).toEqual(['warning', 'caution', 'info']);
+    });
+
+    it('returns an empty list when there are no factors', () => {
+        expect(Core.buildAdvisories({ factors: [] })).toEqual([]);
+    });
+});
+
+describe('travel-safety-core: buildSafetyChecklist', () => {
+    it('always includes the base checklist items', () => {
+        const assessment = { factors: [] };
+        const checklist = Core.buildSafetyChecklist(destination({ id: 'agra' }), SafetyData, assessment);
+        const ids = checklist.map((c) => c.id);
+        expect(ids).toEqual(expect.arrayContaining(['insurance', 'id-copies', 'emergency-numbers']));
+    });
+
+    it('adds an altitude-specific item when altitude risk is active', () => {
+        const assessment = { factors: [{ type: 'altitude', severity: 'caution', message: 'x' }] };
+        const checklist = Core.buildSafetyChecklist(destination({ id: 'leh' }), SafetyData, assessment);
+        expect(checklist.some((c) => c.id === 'altitude-plan')).toBe(true);
+    });
+
+    it('adds a beach water-safety item for beach destinations', () => {
+        const dest = destination({ id: 'goa', categories: ['beaches'] });
+        const checklist = Core.buildSafetyChecklist(dest, SafetyData, { factors: [] });
+        expect(checklist.some((c) => c.id === 'water-safety')).toBe(true);
+    });
+});
+
+describe('travel-safety-core: evaluateItinerarySafety + buildItineraryAlerts', () => {
+    const destinationsById = {
+        agra: destination({ id: 'agra' }),
+        leh: destination({ id: 'leh', name: 'Leh', categories: ['mountains'] })
+    };
+
+    const schedule = [
+        { day: 1, type: 'stay', destId: 'agra', city: 'Agra', activity: 'Explore Taj Mahal' },
+        { day: 2, type: 'travel', from: 'Agra', to: 'Leh' },
+        { day: 3, type: 'stay', destId: 'leh', city: 'Leh', activity: 'Explore monasteries' }
+    ];
+
+    it('attaches a date and safety assessment to each stay day', () => {
+        const evaluated = Core.evaluateItinerarySafety(schedule, destinationsById, SafetyData, {}, '2026-08-01', WeatherCore);
+        const stays = evaluated.filter((e) => e.type === 'stay');
+        expect(stays).toHaveLength(2);
+        stays.forEach((s) => {
+            expect(s.date).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+            expect(s.assessment).not.toBeNull();
+        });
+    });
+
+    it('leaves travel days untouched aside from adding a date', () => {
+        const evaluated = Core.evaluateItinerarySafety(schedule, destinationsById, SafetyData, {}, '2026-08-01', WeatherCore);
+        const travelDay = evaluated.find((e) => e.type === 'travel');
+        expect(travelDay.date).toBe('2026-08-02');
+        expect(travelDay.assessment).toBeUndefined();
+    });
+
+    it('throws on an invalid start date', () => {
+        expect(() => Core.evaluateItinerarySafety(schedule, destinationsById, SafetyData, {}, 'not-a-date', WeatherCore)).toThrow();
+    });
+
+    it('surfaces itinerary alerts only for destinations with a non-info factor', () => {
+        const evaluated = Core.evaluateItinerarySafety(schedule, destinationsById, SafetyData, {}, '2026-08-01', WeatherCore);
+        const alerts = Core.buildItineraryAlerts(evaluated);
+        // Leh carries an altitude (caution) factor; Agra in August carries no active factor.
+        expect(alerts.some((a) => a.destId === 'leh')).toBe(true);
+        expect(alerts.every((a) => a.factors.every((f) => f.severity !== 'info'))).toBe(true);
+    });
+
+    it('deduplicates alerts per destination', () => {
+        const longSchedule = [
+            { day: 1, type: 'stay', destId: 'leh', city: 'Leh', activity: 'Day 1' },
+            { day: 2, type: 'stay', destId: 'leh', city: 'Leh', activity: 'Day 2' }
+        ];
+        const evaluated = Core.evaluateItinerarySafety(longSchedule, destinationsById, SafetyData, {}, '2026-08-01', WeatherCore);
+        const alerts = Core.buildItineraryAlerts(evaluated);
+        const lehAlerts = alerts.filter((a) => a.destId === 'leh');
+        expect(lehAlerts).toHaveLength(1);
+    });
+});

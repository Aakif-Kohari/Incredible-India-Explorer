+/* ==========================================================================
+   TRAVEL SAFETY PAGE — dedicated styles
+   ========================================================================== */
+
+.safety-picker-card {
+    max-width: 900px;
+    margin: 0 auto 24px;
+}
+
+.safety-picker-card label {
+    display: block;
+    font-weight: 600;
+    margin-bottom: 10px;
+}
+
+.safety-picker-row {
+    display: flex;
+    gap: 14px;
+    flex-wrap: wrap;
+}
+
+.safety-picker-row select {
+    flex: 1;
+    min-width: 220px;
+    padding: 12px 14px;
+    border-radius: 10px;
+    border: 1px solid var(--glass-border);
+    background: rgba(255, 255, 255, 0.05);
+    color: inherit;
+    font-size: 1rem;
+}
+
+.safety-result-panel,
+.safety-contacts-panel {
+    max-width: 900px;
+    margin: 24px auto 0;
+    background: var(--glass-bg);
+    border: 1px solid var(--glass-border);
+    border-radius: 24px;
+    padding: 32px;
+    backdrop-filter: blur(12px);
+}
+
+.safety-loading {
+    display: flex;
+    align-items: center;
+    gap: 12px;
+    opacity: 0.8;
+}
+
+.safety-spinner {
+    width: 18px;
+    height: 18px;
+    border: 3px solid var(--glass-border);
+    border-top-color: var(--saffron);
+    border-radius: 50%;
+    display: inline-block;
+    animation: safety-spin 0.8s linear infinite;
+}
+
+@keyframes safety-spin {
+    to { transform: rotate(360deg); }
+}
+
+.safety-score-card {
+    display: flex;
+    align-items: center;
+    gap: 24px;
+    padding-bottom: 20px;
+    margin-bottom: 20px;
+    border-bottom: 1px solid var(--glass-border);
+}
+
+.safety-score-value {
+    font-size: 3rem;
+    font-weight: 800;
+    line-height: 1;
+    font-family: "Outfit", sans-serif;
+}
+
+.safety-score-value span {
+    font-size: 1.1rem;
+    font-weight: 400;
+    opacity: 0.6;
+}
+
+.safety-level-badge {
+    display: inline-block;
+    margin-top: 6px;
+    padding: 4px 12px;
+    border-radius: 999px;
+    font-size: 0.85rem;
+    font-weight: 600;
+}
+
+.safety-level-low .safety-score-value,
+.safety-level-low .safety-level-badge { color: #2e7d32; }
+.safety-level-low .safety-level-badge { background: rgba(46, 125, 50, 0.15); }
+
+.safety-level-moderate .safety-score-value,
+.safety-level-moderate .safety-level-badge { color: #f9a825; }
+.safety-level-moderate .safety-level-badge { background: rgba(249, 168, 37, 0.15); }
+
+.safety-level-elevated .safety-score-value,
+.safety-level-elevated .safety-level-badge { color: #ef6c00; }
+.safety-level-elevated .safety-level-badge { background: rgba(239, 108, 0, 0.15); }
+
+.safety-level-high .safety-score-value,
+.safety-level-high .safety-level-badge { color: #c62828; }
+.safety-level-high .safety-level-badge { background: rgba(198, 40, 40, 0.15); }
+
+.safety-advisories ul,
+.safety-checklist ul,
+.safety-nearby ul,
+.safety-contacts-list {
+    list-style: none;
+    padding: 0;
+    margin: 0 0 16px;
+}
+
+.safety-advisory {
+    padding: 10px 14px;
+    border-radius: 10px;
+    margin-bottom: 8px;
+    background: rgba(255, 255, 255, 0.04);
+}
+
+.safety-sev-warning { border-left: 3px solid #c62828; }
+.safety-sev-caution { border-left: 3px solid #f9a825; }
+.safety-sev-info { border-left: 3px solid #607d8b; }
+
+.safety-no-advisories {
+    opacity: 0.75;
+}
+
+.safety-nearby-grid {
+    display: grid;
+    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
+    gap: 24px;
+    margin-bottom: 16px;
+}
+
+.safety-nearby-grid li {
+    padding: 4px 0;
+    opacity: 0.9;
+}
+
+.safety-checklist h5 {
+    margin: 16px 0 8px;
+    opacity: 0.85;
+}
+
+.safety-checklist label {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+    padding: 6px 0;
+    cursor: pointer;
+}
+
+.safety-contacts-list li {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: baseline;
+    gap: 8px;
+    padding: 10px 0;
+    border-bottom: 1px solid var(--glass-border);
+}
+
+.safety-contacts-list li:last-child {
+    border-bottom: none;
+}
+
+.safety-contact-label {
+    font-weight: 600;
+    min-width: 260px;
+}
+
+.safety-contact-number {
+    color: var(--saffron);
+    font-weight: 700;
+}
+
+.safety-contact-note {
+    flex-basis: 100%;
+    opacity: 0.65;
+    font-size: 0.85rem;
+}
+
+.safety-trip-alerts li {
+    margin-bottom: 8px;
+}

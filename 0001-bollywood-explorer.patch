+++ b/frontend/bollywood-explorer/style.css
@@ -0,0 +1,779 @@
+﻿/* ==========================================================================
+   Bollywood (Telugu Cinema) Explorer - Stylesheet
+   Pure Vanilla CSS matching the application's premium dark aesthetic.
+   Scoped under .bollywood-* class namespace to avoid global conflicts.
+   ========================================================================== */
+
+:root {
+  --bollywood-deep: #120810;
+  --bollywood-deep-light: #1e0e1a;
+  --bollywood-gold: #d4a437;
+  --bollywood-gold-light: #eecb75;
+  --bollywood-gold-dark: #8f6c1e;
+  --bollywood-amber: #ff9500;
+  --bollywood-purple: #c81e4e;
+  --bollywood-purple-light: rgba(200, 30, 78, 0.18);
+  --bollywood-glass: rgba(30, 14, 26, 0.6);
+  --bollywood-border: rgba(212, 164, 55, 0.2);
+  --bollywood-text-main: #f4ece8;
+  --bollywood-text-muted: #a5989e;
+}
+
+body.light-theme .bollywood-main {
+  --bollywood-deep: #fbf6ec;
+  --bollywood-deep-light: #ffffff;
+  --bollywood-glass: rgba(255, 255, 255, 0.7);
+  --bollywood-border: rgba(212, 164, 55, 0.3);
+  --bollywood-text-main: #241016;
+  --bollywood-text-muted: #5b4a51;
+}
+
+/* ---- Page Container ---- */
+.bollywood-main {
+  background-color: var(--bollywood-deep);
+  color: var(--bollywood-text-main);
+  font-family: 'Outfit', sans-serif;
+  overflow-x: hidden;
+  min-height: 100vh;
+}
+
+/* ================================================================
+   HERO SECTION
+   ================================================================ */
+.bollywood-hero {
+  min-height: 65vh;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+  overflow: hidden;
+  padding: 130px 20px 80px;
+  background:
+    linear-gradient(180deg, rgba(13, 10, 24, 0.35), rgba(13, 10, 24, 0.92)),
+    radial-gradient(ellipse at 60% 40%, rgba(200, 30, 78, 0.22) 0%, transparent 55%),
+    radial-gradient(ellipse at 30% 70%, rgba(212, 164, 55, 0.18) 0%, transparent 55%),
+    #0d0a18;
+  text-align: center;
+}
+
+.bollywood-hero::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  background: repeating-linear-gradient(
+    0deg,
+    transparent,
+    transparent 3px,
+    rgba(212, 164, 55, 0.03) 3px,
+    rgba(212, 164, 55, 0.03) 4px
+  );
+  pointer-events: none;
+}
+
+.bollywood-hero-content {
+  position: relative;
+  z-index: 2;
+  width: min(900px, 92%);
+}
+
+.bollywood-kicker {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 24px;
+  padding: 7px 20px;
+  background: rgba(212, 164, 55, 0.1);
+  border: 1px solid rgba(212, 164, 55, 0.32);
+  border-radius: 100px;
+  color: var(--bollywood-gold-light);
+  font-weight: 700;
+  font-size: 0.85rem;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+  backdrop-filter: blur(8px);
+}
+
+.bollywood-hero h1 {
+  font-family: 'Playfair Display', serif;
+  font-size: clamp(3rem, 7vw, 5rem);
+  line-height: 1.1;
+  margin: 0 0 22px;
+  font-weight: 700;
+  color: #ffffff;
+}
+
+.bollywood-hero h1 span {
+  background: linear-gradient(135deg, var(--bollywood-gold-light) 0%, var(--bollywood-gold) 50%, var(--bollywood-amber) 100%);
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+}
+
+.bollywood-hero p {
+  font-size: clamp(1rem, 2vw, 1.2rem);
+  line-height: 1.7;
+  color: #b8b5c8;
+  margin: 0 auto 28px;
+  max-width: 720px;
+}
+
+/* Hero Badges */
+.bollywood-hero-badges {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 10px;
+  margin-bottom: 28px;
+}
+
+.bollywood-badge {
+  display: inline-block;
+  background: rgba(200, 30, 78, 0.18);
+  border: 1px solid rgba(200, 30, 78, 0.3);
+  color: #c4a8ff;
+  padding: 5px 14px;
+  border-radius: 20px;
+  font-size: 0.82rem;
+  font-weight: 600;
+}
+
+/* Bookmark Button */
+.bollywood-bookmark-container {
+  display: flex;
+  justify-content: center;
+  margin-top: 10px;
+}
+
+.bollywood-bookmark-btn {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  color: var(--bollywood-gold-light);
+  padding: 11px 28px;
+  border-radius: 30px;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  font-weight: 600;
+  font-size: 0.95rem;
+  font-family: 'Outfit', sans-serif;
+  transition: all 0.25s ease;
+  backdrop-filter: blur(8px);
+}
+
+.bollywood-bookmark-btn:hover {
+  border-color: var(--bollywood-gold-light);
+  background: rgba(212, 164, 55, 0.12);
+  transform: translateY(-1px);
+}
+
+.bollywood-bookmark-btn.is-saved {
+  background: var(--bollywood-gold-light);
+  color: var(--bollywood-deep);
+  border-color: var(--bollywood-gold-light);
+}
+
+/* ================================================================
+   GENERAL SECTION STYLES
+   ================================================================ */
+.bollywood-section {
+  padding: 80px 0;
+}
+
+.bollywood-section:nth-of-type(even) {
+  background-color: rgba(255, 255, 255, 0.012);
+}
+
+.bollywood-container {
+  width: min(1200px, 92%);
+  margin: 0 auto;
+}
+
+.bollywood-section-header {
+  margin-bottom: 52px;
+  text-align: center;
+}
+
+.bollywood-eyebrow {
+  color: var(--bollywood-gold-light);
+  font-size: 0.82rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: 0.12em;
+  display: block;
+  margin-bottom: 10px;
+}
+
+.bollywood-section-header h2,
+.bollywood-text-block h2 {
+  font-family: 'Playfair Display', serif;
+  font-size: clamp(2rem, 4vw, 2.8rem);
+  margin: 0 0 16px;
+  color: var(--bollywood-text-main);
+}
+
+.bollywood-section-header p {
+  color: var(--bollywood-text-muted);
+  max-width: 680px;
+  margin: 0 auto;
+  line-height: 1.65;
+  font-size: 1.05rem;
+}
+
+/* Two Column Grid */
+.bollywood-grid-2col {
+  display: grid;
+  grid-template-columns: 1.1fr 0.9fr;
+  gap: 52px;
+  align-items: center;
+}
+
+@media (max-width: 900px) {
+  .bollywood-grid-2col {
+    grid-template-columns: 1fr;
+    gap: 32px;
+  }
+}
+
+.bollywood-text-block p {
+  line-height: 1.8;
+  color: var(--bollywood-text-muted);
+  margin-bottom: 20px;
+  font-size: 1.05rem;
+}
+
+.bollywood-text-block p:last-child {
+  margin-bottom: 0;
+}
+
+/* Highlight Box */
+.bollywood-highlight-box {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  border-radius: 18px;
+  padding: 32px;
+  backdrop-filter: blur(12px);
+}
+
+.bollywood-highlight-box h3 {
+  font-family: 'Playfair Display', serif;
+  font-size: 1.45rem;
+  margin: 0 0 18px;
+  color: var(--bollywood-gold-light);
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.bollywood-highlight-box ul {
+  padding-left: 20px;
+  margin: 0;
+}
+
+.bollywood-highlight-box li {
+  color: var(--bollywood-text-muted);
+  margin-bottom: 14px;
+  line-height: 1.65;
+}
+
+.bollywood-highlight-box li:last-child {
+  margin-bottom: 0;
+}
+
+/* ================================================================
+   CARD GRID (Films, Actors)
+   ================================================================ */
+.bollywood-card-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
+  gap: 24px;
+}
+
+.bollywood-card {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  border-radius: 18px;
+  padding: 30px;
+  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
+  backdrop-filter: blur(10px);
+}
+
+.bollywood-card:hover {
+  transform: translateY(-6px);
+  border-color: var(--bollywood-gold-light);
+  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(212, 164, 55, 0.1);
+}
+
+.bollywood-card-icon {
+  font-size: 2.4rem;
+  margin-bottom: 18px;
+  display: block;
+}
+
+.bollywood-card h3 {
+  margin: 0 0 12px;
+  font-family: 'Playfair Display', serif;
+  font-size: 1.3rem;
+  color: var(--bollywood-text-main);
+}
+
+.bollywood-card p {
+  margin: 0;
+  line-height: 1.65;
+  color: var(--bollywood-text-muted);
+  font-size: 0.96rem;
+}
+
+/* ================================================================
+   AWARDS GRID
+   ================================================================ */
+.bollywood-awards-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
+  gap: 24px;
+}
+
+.bollywood-award-card {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  border-radius: 18px;
+  padding: 30px;
+  text-align: center;
+  transition: transform 0.3s ease, border-color 0.3s ease;
+  backdrop-filter: blur(10px);
+  position: relative;
+  overflow: hidden;
+}
+
+.bollywood-award-card::before {
+  content: '';
+  position: absolute;
+  top: 0;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 60%;
+  height: 2px;
+  background: linear-gradient(90deg, transparent, var(--bollywood-gold), transparent);
+  opacity: 0;
+  transition: opacity 0.3s ease;
+}
+
+.bollywood-award-card:hover {
+  transform: translateY(-5px);
+  border-color: var(--bollywood-gold-light);
+}
+
+.bollywood-award-card:hover::before {
+  opacity: 1;
+}
+
+.bollywood-award-icon {
+  font-size: 2.8rem;
+  margin-bottom: 16px;
+}
+
+.bollywood-award-card h3 {
+  font-family: 'Playfair Display', serif;
+  font-size: 1.25rem;
+  margin: 0 0 12px;
+  color: var(--bollywood-gold-light);
+}
+
+.bollywood-award-card p {
+  margin: 0;
+  line-height: 1.65;
+  color: var(--bollywood-text-muted);
+  font-size: 0.95rem;
+}
+
+/* ================================================================
+   INTERACTIVE TIMELINE (Alternating)
+   ================================================================ */
+.bollywood-timeline {
+  position: relative;
+  max-width: 900px;
+  margin: 0 auto;
+  padding: 20px 0;
+}
+
+.bollywood-timeline::before {
+  content: '';
+  position: absolute;
+  left: 50%;
+  top: 0;
+  bottom: 0;
+  width: 2px;
+  background: linear-gradient(
+    180deg,
+    transparent,
+    var(--bollywood-border) 10%,
+    var(--bollywood-border) 90%,
+    transparent
+  );
+  transform: translateX(-50%);
+}
+
+.bollywood-timeline-step {
+  display: flex;
+  justify-content: flex-end;
+  padding-right: calc(50% + 20px);
+  position: relative;
+  margin-bottom: 40px;
+}
+
+.bollywood-timeline-step:nth-child(even) {
+  justify-content: flex-start;
+  padding-right: 0;
+  padding-left: calc(50% + 20px);
+}
+
+.bollywood-timeline-marker {
+  position: absolute;
+  left: 50%;
+  top: 18px;
+  width: 16px;
+  height: 16px;
+  border-radius: 50%;
+  background: var(--bollywood-deep);
+  border: 3px solid var(--bollywood-gold-light);
+  transform: translateX(-50%);
+  z-index: 2;
+  transition: background 0.3s ease, box-shadow 0.3s ease;
+}
+
+.bollywood-timeline-step:hover .bollywood-timeline-marker {
+  background: var(--bollywood-gold);
+  box-shadow: 0 0 12px rgba(212, 164, 55, 0.6);
+}
+
+.bollywood-timeline-card {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  border-radius: 14px;
+  padding: 24px;
+  width: 90%;
+  transition: transform 0.3s ease, border-color 0.3s ease;
+  backdrop-filter: blur(10px);
+}
+
+.bollywood-timeline-card:hover {
+  transform: translateY(-3px);
+  border-color: var(--bollywood-gold-light);
+}
+
+.bollywood-timeline-year {
+  color: var(--bollywood-gold);
+  font-weight: 800;
+  font-size: 1.3rem;
+  margin-bottom: 8px;
+  display: block;
+}
+
+.bollywood-timeline-card h3 {
+  margin: 0 0 10px;
+  font-size: 1.15rem;
+  color: var(--bollywood-text-main);
+}
+
+.bollywood-timeline-card p {
+  margin: 0;
+  color: var(--bollywood-text-muted);
+  line-height: 1.65;
+  font-size: 0.95rem;
+}
+
+/* Responsive Timeline */
+@media (max-width: 768px) {
+  .bollywood-timeline::before {
+    left: 20px;
+  }
+  .bollywood-timeline-step {
+    justify-content: flex-start;
+    padding-left: 48px;
+    padding-right: 0;
+  }
+  .bollywood-timeline-step:nth-child(even) {
+    padding-left: 48px;
+  }
+  .bollywood-timeline-marker {
+    left: 20px;
+  }
+  .bollywood-timeline-card {
+    width: 100%;
+  }
+}
+
+/* ================================================================
+   GALLERY GRID
+   ================================================================ */
+.bollywood-gallery-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
+  gap: 20px;
+}
+
+.bollywood-gallery-item {
+  position: relative;
+  border-radius: 14px;
+  overflow: hidden;
+  aspect-ratio: 4 / 3;
+  border: 1px solid var(--bollywood-border);
+  cursor: pointer;
+  transition: border-color 0.3s ease, transform 0.3s ease;
+}
+
+.bollywood-gallery-item:hover {
+  border-color: var(--bollywood-gold-light);
+  transform: translateY(-4px);
+}
+
+.bollywood-gallery-item:focus {
+  outline: 2px solid var(--bollywood-gold-light);
+  outline-offset: 2px;
+}
+
+/* Styled placeholder backgrounds (gradient-based, no external images needed) */
+.bollywood-gallery-placeholder {
+  width: 100%;
+  height: 100%;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+}
+
+.bollywood-gallery-bg-1 {
+  background: linear-gradient(135deg, #1a0a2e 0%, #2d1b69 50%, #1a0a2e 100%);
+}
+
+.bollywood-gallery-bg-2 {
+  background: linear-gradient(135deg, #1a1a0a 0%, #4a3d00 50%, #2a2800 100%);
+}
+
+.bollywood-gallery-bg-3 {
+  background: linear-gradient(135deg, #0a1a2e 0%, #0d3060 50%, #0a1a2e 100%);
+}
+
+.bollywood-gallery-bg-4 {
+  background: linear-gradient(135deg, #1a0a0a 0%, #5c1a00 50%, #3a1000 100%);
+}
+
+.bollywood-gallery-icon {
+  font-size: 4rem;
+  opacity: 0.5;
+  transition: opacity 0.3s ease, transform 0.3s ease;
+}
+
+.bollywood-gallery-item:hover .bollywood-gallery-icon {
+  opacity: 0.8;
+  transform: scale(1.15);
+}
+
+.bollywood-gallery-overlay {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(0deg, rgba(13, 10, 24, 0.95) 0%, rgba(13, 10, 24, 0.45) 55%, transparent 100%);
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-end;
+  padding: 22px;
+  transition: background 0.3s ease;
+}
+
+.bollywood-gallery-overlay h4 {
+  margin: 0 0 4px;
+  font-size: 1.15rem;
+  font-weight: 600;
+  color: #ffffff;
+  font-family: 'Playfair Display', serif;
+}
+
+.bollywood-gallery-overlay p {
+  margin: 0;
+  font-size: 0.85rem;
+  color: var(--bollywood-gold-light);
+}
+
+/* ================================================================
+   REFERENCES SECTION
+   ================================================================ */
+.bollywood-references {
+  background: var(--bollywood-glass);
+  border: 1px solid var(--bollywood-border);
+  border-radius: 18px;
+  padding: 42px;
+  backdrop-filter: blur(10px);
+}
+
+.bollywood-references h3 {
+  font-family: 'Playfair Display', serif;
+  font-size: 1.45rem;
+  margin: 0 0 22px;
+  color: var(--bollywood-text-main);
+}
+
+.bollywood-references ul {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+}
+
+.bollywood-references li {
+  position: relative;
+  padding-left: 26px;
+  margin-bottom: 16px;
+  line-height: 1.65;
+  color: var(--bollywood-text-muted);
+  font-size: 0.98rem;
+}
+
+.bollywood-references li:last-child {
+  margin-bottom: 0;
+}
+
+.bollywood-references li::before {
+  content: '📖';
+  position: absolute;
+  left: 0;
+  top: 2px;
+  font-size: 0.9rem;
+}
+
+/* ================================================================
+   PAGE FOOTER
+   ================================================================ */
+.bollywood-footer {
+  padding: 42px 0;
+  text-align: center;
+  color: var(--bollywood-text-muted);
+  border-top: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.bollywood-footer a {
+  color: var(--bollywood-gold-light);
+  text-decoration: none;
+  font-weight: 600;
+  transition: color 0.2s ease;
+}
+
+.bollywood-footer a:hover {
+  color: var(--bollywood-gold);
+}
+
+/* ================================================================
+   INTERACTIVE DETAIL MODAL
+   ================================================================ */
+.museum-modal {
+  position: fixed;
+  inset: 0;
+  z-index: 1600;
+  display: none;
+  place-items: center;
+  padding: 20px;
+  background: rgba(0, 0, 0, 0.8);
+  backdrop-filter: blur(12px);
+}
+
+.museum-modal.open {
+  display: grid;
+}
+
+.museum-modal-card {
+  position: relative;
+  width: min(680px, 96vw);
+  max-height: 90vh;
+  overflow: auto;
+  padding: 32px;
+  border: 1px solid var(--bollywood-border);
+  border-radius: 24px;
+  background: var(--bollywood-deep-light);
+  color: var(--bollywood-text-main);
+  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
+}
+
+.museum-modal-close {
+  position: absolute;
+  top: 14px;
+  right: 14px;
+  width: 38px;
+  height: 38px;
+  border: 1px solid var(--bollywood-border);
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.06);
+  color: var(--bollywood-text-muted);
+  font-size: 1.4rem;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  line-height: 1;
+  font-family: 'Outfit', sans-serif;
+  transition: background 0.2s ease;
+}
+
+.museum-modal-close:hover {
+  background: rgba(255, 255, 255, 0.15);
+}
+
+.modal-category {
+  display: inline-block;
+  margin-bottom: 10px;
+  color: var(--bollywood-gold-light);
+  font-weight: 800;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  font-size: 0.8rem;
+}
+
+.museum-modal-card h2 {
+  margin: 0 42px 8px 0;
+  font-family: 'Playfair Display', serif;
+  font-size: clamp(1.8rem, 3.5vw, 2.5rem);
+  color: var(--bollywood-text-main);
+}
+
+.modal-location {
+  margin: 0 0 20px;
+  color: var(--bollywood-text-muted);
+  font-weight: 600;
+}
+
+.modal-description {
+  margin: 0;
+  color: var(--bollywood-text-muted);
+  line-height: 1.75;
+}
+
+body.modal-open {
+  overflow: hidden;
+}
+
+/* ================================================================
+   RESPONSIVE OVERRIDES
+   ================================================================ */
+@media (max-width: 600px) {
+  .bollywood-hero {
+    padding: 110px 16px 60px;
+  }
+
+  .bollywood-hero h1 {
+    font-size: 2.6rem;
+  }
+
+  .bollywood-hero-badges {
+    gap: 8px;
+  }
+
+  .bollywood-card-grid,
+  .bollywood-awards-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .bollywood-gallery-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .bollywood-references {
+    padding: 28px 20px;
+  }
+}

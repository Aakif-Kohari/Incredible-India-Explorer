{
  "name": "incredible-india-explorer",
  "version": "1.0.0",
  "description": "Interactive digital experience showcasing the rich culture, history, geography, and wildlife of India",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "a11y": "node frontend/scripts/accessibility-check.js",
    "generate": "node frontend/scripts/generate.cjs",
    "generate:check": "node frontend/scripts/generate.cjs --check",
    "build": "node scripts/minify.js",
    "dev": "npx serve ."
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "jsdom": "^29.1.1",
    "terser": "^5.49.2",
    "vitest": "^3.1.0"
  }
}
